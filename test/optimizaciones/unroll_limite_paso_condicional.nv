functio elegir(x : integer) -> integer {
    si (x == 0) {
        redde 1;
    } aliter {
        redde 2;
    }
}

functio principale() -> integer {
    varia i : integer = 0;
    varia suma : integer = 0;
    varia limite : integer = 0;
    varia paso : integer = 0;
    si (elegir(0) == 1) {
        limite = 3;
        paso = 2;
    } aliter {
        limite = 4;
        paso = 1;
    }
    dum (i < limite) {
        suma += i;
        i = i + paso;
    }
    redde suma;
}
