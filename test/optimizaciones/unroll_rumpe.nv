functio obtener_limite() -> integer {
    redde 8;
}

functio principale() -> integer {
    varia limite : integer = obtener_limite();
    varia suma : integer = 0;
    per (varia i : integer = 0; i < limite; i += 1) {
        si (i == 3) {
            rumpe;
        }
        suma += i;
    }
    redde suma;
}
